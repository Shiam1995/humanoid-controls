<mujoco model="dtt_tokamak">
  <include file="vessel.xml"/>
  <compiler inertiafromgeom="true"/>
  <option timestep="0.0005" gravity="0 0 -9.81"/>

  <worldbody>
    <!-- DTT arm base mounted at port entry -->
    <!-- Sized for 650x600mm port from Calvo et al. -->
    <body name="base" pos="0 -0.5 0.5">
      <geom type="box" size="0.05 0.05 0.05" rgba="0.5 0.5 0.8 1"/>
      
      <!-- Link 1: d=300mm from Calvo DH table -->
      <body name="link1" pos="0 0 0.1">
        <joint name="j1" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
        <geom type="cylinder" size="0.035 0.15" rgba="0.4 0.4 0.9 1"/>
        
        <!-- Link 2: d=0, a=0 -->
        <body name="link2" pos="0 0 0.30">
          <joint name="j2" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
          <geom type="cylinder" size="0.030 0.10" rgba="0.3 0.3 0.8 1"/>
          
          <!-- Link 3: d=175mm from Calvo DH table -->
          <body name="link3" pos="0 0 0.175">
            <joint name="j3" type="hinge" axis="0 1 0" range="-3.14 3.14"/>
            <geom type="cylinder" size="0.025 0.09" rgba="0.4 0.4 0.9 1"/>
            
            <!-- Link 4: d=0 -->
            <body name="link4" pos="0 0 0.15">
              <joint name="j4" type="hinge" axis="0 1 0" range="-1.57 1.57"/>
              <geom type="cylinder" size="0.022 0.08" rgba="0.3 0.3 0.8 1"/>
              
              <!-- Link 5: d=160mm from Calvo DH table -->
              <body name="link5" pos="0 0 0.160">
                <joint name="j5" type="hinge" axis="0 0 1" range="-3.14 3.14"/>
                <geom type="cylinder" size="0.020 0.07" rgba="0.4 0.4 0.9 1"/>
                
                <!-- Link 6: a=75mm from Calvo DH table -->
                <body name="link6" pos="0.075 0 0.10">
                  <joint name="j6" type="hinge" axis="0 1 0" range="-3.14 3.14"/>
                  <geom type="cylinder" size="0.018 0.06" rgba="0.3 0.3 0.8 1"/>
                  
                  <!-- End effector -->
                  <body name="ee_dtt" pos="0 0 0.06">
                    <geom type="sphere" size="0.02" rgba="0.0 0.5 1.0 1"/>
                    <site name="ee_site_dtt" pos="0 0 0"/>
                  </body>
                  
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="a1" joint="j1" kv="2"/>
    <velocity name="a2" joint="j2" kv="2"/>
    <velocity name="a3" joint="j3" kv="2"/>
    <velocity name="a4" joint="j4" kv="2"/>
    <velocity name="a5" joint="j5" kv="2"/>
    <velocity name="a6" joint="j6" kv="2"/>
  </actuator>

</mujoco>
