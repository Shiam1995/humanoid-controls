<mujoco model="franka_tokamak">
  <include file="vessel.xml"/>
  <compiler inertiafromgeom="true"/>
  <option timestep="0.0005" gravity="0 0 -9.81"/>
  <worldbody>

    <!-- Franka base mounted at port entry -->
    <body name="base" pos="0 -0.5 0.5">
      <geom type="box" size="0.05 0.05 0.05" rgba="0.5 0.5 0.5 1"/>
      
      <body name="link1" pos="0 0 0.1">
        <joint name="j1" type="hinge" axis="0 0 1" range="-2.8 2.8"/>
        <geom type="cylinder" size="0.04 0.08" rgba="0.8 0.8 0.8 1"/>
        
        <body name="link2" pos="0 0 0.1">
          <joint name="j2" type="hinge" axis="0 1 0" range="-1.7 1.7"/>
          <geom type="cylinder" size="0.035 0.1" rgba="0.7 0.7 0.7 1"/>
          
          <body name="link3" pos="0 0 0.2">
            <joint name="j3" type="hinge" axis="0 0 1" range="-2.8 2.8"/>
            <geom type="cylinder" size="0.03 0.08" rgba="0.8 0.8 0.8 1"/>
            
            <body name="link4" pos="0 0 0.15">
              <joint name="j4" type="hinge" axis="0 1 0" range="-3.0 -0.07"/>
              <geom type="cylinder" size="0.03 0.08" rgba="0.7 0.7 0.7 1"/>
              
              <body name="link5" pos="0 0 0.15">
                <joint name="j5" type="hinge" axis="0 0 1" range="-2.8 2.8"/>
                <geom type="cylinder" size="0.025 0.07" rgba="0.8 0.8 0.8 1"/>
                
                <body name="link6" pos="0 0 0.12">
                  <joint name="j6" type="hinge" axis="0 1 0" range="-0.01 3.75"/>
                  <geom type="cylinder" size="0.025 0.06" rgba="0.7 0.7 0.7 1"/>
                  
                  <body name="link7" pos="0 0 0.1">
                    <joint name="j7" type="hinge" axis="0 0 1" range="-2.8 2.8"/>
                    <geom type="cylinder" size="0.02 0.05" rgba="0.8 0.8 0.8 1"/>
                    
                    <!-- End effector -->
                    <body name="ee_franka" pos="0 0 0.08">
                      <geom type="sphere" size="0.02" rgba="1.0 0.5 0.0 1"/>
                      <site name="ee_site_franka" pos="0 0 0"/>
                    </body>
                    
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="a1" joint="j1" kv="2"/>
    <velocity name="a2" joint="j2" kv="2"/>
    <velocity name="a3" joint="j3" kv="2"/>
    <velocity name="a4" joint="j4" kv="2"/>
    <velocity name="a5" joint="j5" kv="2"/>
    <velocity name="a6" joint="j6" kv="2"/>
    <velocity name="a7" joint="j7" kv="2"/>
  </actuator>

</mujoco>
